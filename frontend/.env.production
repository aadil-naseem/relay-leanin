# Production build configuration (committed on purpose - this is a public URL,
# not a secret, and baking it here means the build cannot miss it).
#
# Vite loads this file for `vite build` (production mode) only, so `npm run dev`
# still talks to http://localhost:8000/api/v1.
#
# An environment variable set in the host dashboard (e.g. Vercel
# VITE_API_URL) takes precedence over this file. See docs/DEPLOY.md.
VITE_API_URL=https://relay-api-l6df.onrender.com/api/v1
